load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//tools:windows_resource.bzl", "windows_resource")

windows_resource(
    name = "plugin_manifest",
    src = "plugin.rc",
    deps = ["//plugin/third_party/sdk:sdk"],
)

[cc_binary(
    name = "d2rl-%s.dll" % plugin,
    srcs = ["%s.cpp" % plugin, "distance_control.h", "distance_client.h", "distance_settings.h", "center_target.h", "settings_model.h", "settings_ui.h", "loader_gear_pixels.h", "marker_frame.h", "elite_target.h", "target_health.h", "target_ring_runtime.h", "target_ring.h", "nearest_target.h", "target_key.h", "movement_math.h", "cursor_hold.h", "automap_runtime.h", "automap_math.h", "automap_packets.h", "click_target_runtime.h", "click_target_native.h", "click_target.h", "target_runtime.h", "target_provider.h", "target_selection.h", "target_world.h"],
    copts = [
        "/utf-8",
        "/W3",
        "/EHsc",
        "/permissive-",
    ],
    linkopts = ["user32.lib"],
    linkshared = True,
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":plugin_manifest",
        "//plugin/third_party/sdk:sdk",
    ],
) for plugin in [
    "3dcam",
    "renderdistance",
]]

cc_test(
    name = "distance_control_test",
    srcs = ["distance_control_test.cpp", "distance_control.h", "distance_client.h", "distance_settings.h"],
    copts = ["/EHsc"],
    deps = ["//plugin/third_party/sdk:sdk"],
    target_compatible_with = ["@platforms//os:windows"],
)

